APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Server terminologi FHIR (LOV SNOMED). snomed_version = pin edisi agar hasil
# pencarian tidak berisi konsep baru yang ditolak SATUSEHAT (RuleNumber 10003).
# TXFHIR_BASE_URL=http://tx.fhir.org/r4
# TXFHIR_SNOMED_VERSION=http://snomed.info/sct/900000000000207008/version/20240201

# Host API Mobile JKN (Antrean Online BPJS), tanpa http:// dan port.
# Path endpoint di root host ini (/auth, /ambilantrean, ...) = URL terdaftar di BPJS.
# Kosong = route API Mobile JKN tidak dimuat.
# MOBILE_JKN_HOST=
# Rahasia JWT /auth Mobile JKN (acak ≥ 32 karakter). Kosong = kunci lama di kode (hanya untuk masa peralihan).
MOBILE_JKN_JWT_SECRET=

# API SIAP (penggajian, baca saja) — isi SIAP_API_JWT_SECRET (≥ 32 karakter acak) untuk mengaktifkan.
# Akun API = user SIRUS ber-role SIAP_API_ROLE: buat dengan `php artisan siap-api:akun siap-gaji`.
SIAP_API_ROLE="Api Siap"
# Host khusus API SIAP (tanpa http:// dan port). Kosong = /api/siap di host SIRUS biasa (ditolak di host Mobile JKN);
# diisi = hanya host ini, halaman SIRUS ditutup di host itu (pola Mobile JKN).
SIAP_API_HOST=
SIAP_API_JWT_SECRET=
SIAP_API_TOKEN_TTL=3600
SIAP_API_IP_WHITELIST=

# ========================================================
# APOTEK ONLINE BPJS (apotek-rest) — klaim obat PRB / kronis belum stabil / kemoterapi
# Dipakai App\Http\Traits\BPJS\ApotekTrait.
#
# cons-id apotek DIDAFTARKAN TERPISAH dari VClaim: kredensial VClaim yang jalan di
# modul lain ditolak di sini dengan "Unauthorized! You are not registered for this
# service!". Jangan disatukan meski rumus signature-nya identik.
#
# Ganti lingkungan cukup menukar komentar URL-nya — pola yang sudah dipakai blok
# VCLAIM/ANTRIAN/ICARE/APLICARES di .env repo ini.
# ========================================================
# APOTEK_URL="https://apijkn-dev.bpjs-kesehatan.go.id/apotek-rest-dev/"   # development
# APOTEK_URL="https://apijkn.bpjs-kesehatan.go.id/apotek-rest/"          # produksi
# APOTEK_CONS_ID=""
# APOTEK_SECRET_KEY=""
# APOTEK_USER_KEY=""
# APOTEK_KDPPK=""        # kode faskes apotek BPJS, mis. 0184A012 (IFRS)
