APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Server terminologi FHIR (LOV SNOMED). snomed_version = pin edisi agar hasil
# pencarian tidak berisi konsep baru yang ditolak SATUSEHAT (RuleNumber 10003).
# TXFHIR_BASE_URL=http://tx.fhir.org/r4
# TXFHIR_SNOMED_VERSION=http://snomed.info/sct/900000000000207008/version/20240201

# ── Rujukan Berbasis Kompetensi (SRBK) ──────────────────────────────────────
# Dua jalur, kredensialnya TERPISAH:
#   RJ  → poli RS lain : lewat BPJS vclaim-sisrute-rest (blok SISRUTE_*)
#   RI/UGD → Ranap/IGD : langsung FHIR SATUSEHAT (blok SATUSEHAT_RUJUKAN_*)
#
# SATUSEHAT_RUJUKAN_* SENGAJA berdiri sendiri, TIDAK menumpang SATUSEHAT_*:
# client_id/secret rujukan diterbitkan khusus oleh tim SATUSEHAT Rujukan
# (bukan yang tampil di dashboard platform), dan organization id-nya dipisah
# supaya modul rujukan bisa menunjuk org/lingkungan berbeda tanpa mengganggu
# integrasi SATUSEHAT yang sudah jalan.
SISRUTE_URL="https://apijkn-dev.bpjs-kesehatan.go.id/vclaim-sisrute-rest"
SISRUTE_CONS_ID=
SISRUTE_SECRET_KEY=
SISRUTE_USER_KEY=
SISRUTE_KDPPK=

SATUSEHAT_RUJUKAN_AUTH_URL="https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1/"
SATUSEHAT_RUJUKAN_BASE_URL="https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1/"
SATUSEHAT_RUJUKAN_CLIENT_ID=
SATUSEHAT_RUJUKAN_SECRET_ID=
SATUSEHAT_RUJUKAN_ORGANIZATION_ID=
SATUSEHAT_RUJUKAN_ORGANIZATION_NAME=
